---
import Badge from "@/components/Badge.astro"
import GitHubIcon from "@/components/icons/GitHub.astro"
import LinkedInIcon from "@/components/icons/LinkedIn.astro"
import MailIcon from "@/components/icons/Mail.astro"
import SocialPill from "@/components/SocialPill.astro"
---

<div class="max-w-xl">
  <div class="anim-fade-in flex flex-wrap gap-4 mb-6 items-center">
    <h1
      class="text-4xl font-bold tracking-tight text-slate-800 sm:text-5xl dark:text-white"
    >
      Ramiro Busto
    </h1>
    <Badge><span data-i18n="hero.badge">Software Developer | .NET & Databases</span></Badge>
  </div>

  <p
    class="anim-fade-in anim-delay-2 mt-6 text-xl text-slate-800 dark:text-slate-300"
  >
    <span data-i18n="hero.description">Estudiante de Ingeniería en Sistemas y profesional de IT con experiencia en administración y gestión de bases de datos. También cuento con experiencia en desarrollo de aplicaciones utilizando C#/.NET. Perfil orientado a la resolución de problemas, la optimización de procesos y la construcción de soluciones de software.</span>
  </p>

  <nav
    class="anim-fade-in anim-delay-3 flex flex-wrap gap-4 mt-8"
    aria-label="Redes sociales y contacto"
  >
    <SocialPill href="mailto:ramirobus81@gmail.com">
      <MailIcon class="size-4" />
      <span data-i18n="hero.contact">Contacto</span>
    </SocialPill>
    <SocialPill href="https://linkedin.com/in/ramiro-busto">
      <LinkedInIcon class="size-4" />
      LinkedIn
    </SocialPill>
    <SocialPill href="https://github.com/ramiro-busto">
      <GitHubIcon class="size-4" />
      GitHub
    </SocialPill>
    <div class="relative group/cv">
      <button
        class="inline-flex items-center justify-center gap-2 px-4 py-1 text-slate-800 transition bg-slate-100 border border-slate-300 rounded-full dark:bg-slate-800 dark:border-slate-600 dark:text-white text-md hover:bg-slate-900 hover:border-slate-700 hover:text-white dark:hover:bg-white dark:hover:border-slate-300 dark:hover:text-black max-w-fit focus:outline-none cursor-pointer"
      >
        <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        <span data-i18n="hero.cv">CV</span>
        <svg class="size-3 transition-transform group-hover/cv:rotate-180" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div class="absolute top-full left-0 pt-2 hidden group-hover/cv:block z-50">
        <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl shadow-lg overflow-hidden min-w-[160px]">
          <a
            href="/cv-ramiro-es.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 px-4 py-2.5 text-sm text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition"
          >
            🇪🇸 Español
          </a>
          <a
            href="/cv-ramiro-en.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 px-4 py-2.5 text-sm text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition"
          >
            🇬🇧 English
          </a>
        </div>
      </div>
    </div>
  </nav>
</div>
