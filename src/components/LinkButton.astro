---
const { href } = Astro.props;
---

<a
    target="_blank"
    href={href}
    class="inline-flex bg-slate-100 text-slate-800 border-slate-300 items-center justify-center gap-2 px-3 py-2 space-x-2 text-base transition dark:text-white dark:bg-slate-800 border dark:border-slate-600 focus-visible:ring-white/80 text-md hover:bg-slate-800 hover:border-slate-900 group max-w-fit rounded-xl hover:text-white focus:outline-none focus-visible:outline-none focus-visible:ring focus-visible:ring-white focus-visible:ring-offset-2 active:bg-black"
>
    <slot />
</a>
