---
const currentYear = new Date().getFullYear()
---

<footer class="m-4 mt-16 w-full mx-auto container lg:max-w-4xl md:max-w-2xl mb-10">
  <div class="w-full px-6 py-5 rounded-xl bg-slate-100/80 dark:bg-white/5 backdrop-blur-sm border border-slate-200 dark:border-white/10 flex flex-col md:flex-row items-center justify-between gap-4">
    <span class="text-sm text-slate-600 dark:text-slate-300">
      &copy; {currentYear} <strong class="text-slate-900 dark:text-white">Ramiro Busto</strong>. <span data-i18n="footer.rights">Todos los derechos reservados.</span>
    </span>
    <ul class="flex flex-wrap items-center gap-4 text-sm font-medium text-slate-600 dark:text-slate-300">
      <li>
        <a href="/#sobre-mi" class="hover:text-slate-900 dark:hover:text-white transition-colors"><span data-i18n="footer.about">Sobre mí</span></a>
      </li>
      <li>
        <a href="/#experiencia" class="hover:text-slate-900 dark:hover:text-white transition-colors"><span data-i18n="footer.experience">Experiencia</span></a>
      </li>
      <li>
        <a href="/#educacion" class="hover:text-slate-900 dark:hover:text-white transition-colors"><span data-i18n="footer.education">Educación</span></a>
