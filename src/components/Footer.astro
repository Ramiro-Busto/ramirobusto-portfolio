      </li>
      <li>
        <a href="https://linkedin.com/in/ramiro-busto" target="_blank" rel="noopener noreferrer" class="hover:text-slate-900 dark:hover:text-white transition-colors"><span data-i18n="footer.linkedin">LinkedIn</span></a>
      </li>
      <li>
        <a href="https://github.com/ramiro-busto" target="_blank" rel="noopener noreferrer" class="hover:text-slate-900 dark:hover:text-white transition-colors"><span data-i18n="footer.github">GitHub</span></a>
      </li>
      <li>
        <a href="mailto:ramirobus81@gmail.com" class="hover:text-slate-900 dark:hover:text-white transition-colors"><span data-i18n="footer.contact">Contacto</span></a>
      </li>
