  const translations: Record<string, Record<string, string>> = { es, en }

  const getLang = (): string => {
    if (typeof localStorage !== "undefined") {
      return localStorage.getItem(LANG_KEY) || "es"
    }
    return "es"
  }

  const applyTranslations = (t: Record<string, string>, lang: string) => {
    document.querySelectorAll<HTMLElement>("[data-i18n]").forEach((el) => {
      const key = el.getAttribute("data-i18n")
      if (key && key.endsWith(".tags")) {
        const tagsAttr = el.getAttribute(`data-i18n-tags-${lang}`)
        if (tagsAttr) {
          try {
            const tags: string[] = JSON.parse(tagsAttr)
            el.innerHTML = tags
              .map((tag) => `<li><span class="rounded-full text-xs bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300 py-1 px-2.5 font-medium">${tag}</span></li>`)
              .join("")
          } catch {}
        }
      } else if (key && t[key] !== undefined) {
        el.textContent = t[key]
      }
    })
  }

  const updateLang = () => {
    const lang = getLang()
    const t = translations[lang] || translations["es"]
    applyTranslations(t, lang)
    const label = document.getElementById("lang-label")
    if (label) label.textContent = lang.toUpperCase()
    document.documentElement.setAttribute("lang", lang)
  }

  updateLang()

  document.getElementById("lang-toggle-btn")?.addEventListener("click", () => {
    const next = getLang() === "es" ? "en" : "es"
    localStorage.setItem(LANG_KEY, next)
    updateLang()
  })

  document.addEventListener("astro:after-swap", updateLang)
</script>
